# .gitignore for Salesforce Projects

# Project settings and local configuration
.sf/
.sfdx/
.localdevserver/

# Node.js dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Temporary files
tmp/
temp/

# IDE settings
.idea/
.vscode/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Environment variables and secrets
.env
.env.*
!.env.example

# Test reports and coverage
.nyc_output/
coverage/
test-results/

# Backup files
*.bak
*.tmp
*.swp
*.swo
